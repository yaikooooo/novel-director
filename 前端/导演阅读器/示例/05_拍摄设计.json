    "shots": {
      "S001": {
        "frame_id": "S001-F01",
        "intent": "让门外脚步打断观众对室内的观察。",
        "prompt": "3秒。起幅用远景同时看见左侧房门与右侧桌边的人，右窗光照着书页。前段保持参考图的空间关系，约1.46秒仍处于正式图构图。约2.5秒门外传来脚步，摄影机才朝门的方向横移，把门在画面中的分量加重，桌边的人仍在右侧。刚建立向门的动势便切到人物中景，脚步延续。"
      },
      "S002": {
        "frame_id": "S002-F01",
        "intent": "让停手与迟来的转头显出人物对脚步的在意。",
        "prompt": "2.5秒。承接前镜的脚步，固定在人物腰以上的中景，书页和桌角留在下方，窗光继续从画右进入。人物先停住翻页的手，稍后才向画左门口转眼；约1.21秒经过正式图中手搭书页、视线朝门的构图。摄影机留在原位，看他保持这个迟疑姿势。落幅保住手与侧脸，脚步尾音消退后，接下一镜的手部特写。"
      }
    },
